{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    // Vite does all transpilation; tsc is used purely as a type checker.
    // Without noEmit, `tsc && vite build` emits .js/.d.ts next to the sources,
    // which then shadow the .tsx files during module resolution.
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
