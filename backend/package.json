{
  "name": "seo-audit-backend",
  "version": "1.0.0",
  "description": "Technical SEO Audit Tool - Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "p-limit": "^5.0.0",
    "tldjs": "^2.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@vitest/coverage-v8": "^0.34.6",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
