# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Get this from your MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/seo-audit?retryWrites=true&w=majority

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Crawler Configuration
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_CONCURRENCY=5
CRAWLER_MAX_NAV_LINKS=20

# Logging
LOG_LEVEL=info
